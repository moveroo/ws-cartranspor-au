{
  "name": "cartransport-au",
  "type": "module",
  "version": "0.0.1",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "seo:audit": "node scripts/seo-audit.mjs",
    "analyze:headings": "node scripts/analyze-question-headings.mjs",
    "analyze:duplicates": "node scripts/detect-duplicate-seo.mjs",
    "analyze:alt-text": "node scripts/analyze-image-alt-text.mjs",
    "analyze:content": "node scripts/analyze-content-uniqueness.mjs",
    "suggest:content": "node scripts/suggest-content-improvements.mjs",
    "validate": "node scripts/validate-structure.mjs",
    "check:structure": "node scripts/analyze-heading-structure.mjs",
    "check:links": "node scripts/analyze-internal-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/roboto": "^5.2.9",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^5.16.6",
    "astro-icon": "^1.1.5",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^1.5.0",
    "happy-dom": "^20.0.11",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "typescript-eslint": "^8.51.0",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.7"
  }
}

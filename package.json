{
  "name": "cartransport-au",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-contact-routing.mjs --dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:contract": "node ./scripts/check-contract.mjs && node scripts/check-agent-discovery.mjs && node scripts/check-lead-intent-contract.mjs && node scripts/check-contact-routing.mjs",
    "check:contact-routing": "node scripts/check-contact-routing.mjs",
    "check:seo": "node scripts/check-seo.mjs && node scripts/check-homepage-h1.mjs",
    "check:homepage-h1": "node scripts/check-homepage-h1.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "seo:audit": "node scripts/seo-audit.mjs",
    "analyze:headings": "node scripts/analyze-question-headings.mjs",
    "analyze:duplicates": "node scripts/detect-duplicate-seo.mjs",
    "analyze:alt-text": "node scripts/analyze-image-alt-text.mjs",
    "analyze:content": "node scripts/analyze-content-uniqueness.mjs",
    "suggest:content": "node scripts/suggest-content-improvements.mjs",
    "validate": "node scripts/validate-structure.mjs",
    "check:structure": "node scripts/analyze-heading-structure.mjs",
    "check:links": "node scripts/analyze-internal-links.mjs",
    "indexnow:dry-run": "node ./scripts/indexnow-submit.mjs --dry-run",
    "indexnow:submit": "node ./scripts/indexnow-submit.mjs --live --force",
    "check:agent-discovery": "node scripts/check-agent-discovery.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/roboto": "^5.2.9",
    "@jdevalk/astro-seo-graph": "^2.2.0",
    "@jdevalk/seo-graph-core": "^0.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^7.0.7",
    "astro-icon": "^1.1.5",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "happy-dom": "^20.0.11",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript-eslint": "^8.51.0",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.3"
  }
}

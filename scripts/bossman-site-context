#!/usr/bin/env sh

set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MANIFEST_FILE="$SCRIPT_DIR/../bossman-site-manifest.json"

DOMAIN="${1:-$(node -e "const fs = require('fs'); const path = process.argv[1]; const manifest = JSON.parse(fs.readFileSync(path, 'utf8')); process.stdout.write((manifest.domain || '').trim());" "$MANIFEST_FILE")}"

if [ -z "$DOMAIN" ]; then
  echo "Usage: scripts/bossman-site-context [domain]" >&2
  echo "Example: scripts/bossman-site-context cartransport.au" >&2
  echo "The domain is loaded from bossman-site-manifest.json if omitted." >&2
  exit 1
fi

exec /Users/jasonhill/Projects/Systems/bossman-laravel-v2/scripts/bossman-site-context "$DOMAIN"

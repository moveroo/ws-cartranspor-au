---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
}

import BrainAnalytics from './BrainAnalytics.astro';

const {
  title,
  description = import.meta.env.PUBLIC_SITE_DESCRIPTION || '',
  image = import.meta.env.PUBLIC_SITE_IMAGE || '',
  type = 'website',
  canonical = Astro.url.href,
  noindex = false,
} = Astro.props;

const siteName = import.meta.env.PUBLIC_SITE_NAME || 'My Site';
const pageTitle = title ? `${title} | ${siteName}` : siteName;
// MM BRAIN Matomo rollout
const matomoBaseUrl = (
  import.meta.env.PUBLIC_MATOMO_BASE_URL || 'https://stats.redirection.com.au'
).replace(/\/$/, '');
const matomoSiteId = import.meta.env.PUBLIC_MATOMO_SITE_ID || '11';
---

<!doctype html>
<html lang={Astro.props.lang || 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.url)} />}
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    {image && <meta property="twitter:image" content={new URL(image, Astro.url)} />}

    <BrainAnalytics />
    <!-- MM BRAIN Matomo -->
    <link rel="preconnect" href={matomoBaseUrl} />
    <link rel="dns-prefetch" href={matomoBaseUrl} />
    {
      matomoBaseUrl && matomoSiteId && (
        <script
          is:inline
          set:html={`var _paq = window._paq = window._paq || []; _paq.push(['trackPageView']); _paq.push(['enableLinkTracking']); (function() { var u='${matomoBaseUrl}/'; _paq.push(['setTrackerUrl', u + 'piwik.php']); _paq.push(['setSiteId', '${matomoSiteId}']); var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0]; g.async=true; g.src=u + 'piwik.js'; s.parentNode.insertBefore(g,s); })();`}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

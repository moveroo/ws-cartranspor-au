---
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  breadcrumbLabel?: string;
}

const { title, description, image, type, noindex, breadcrumbLabel } = Astro.props;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import { site } from '../config/site';

const currentPath = Astro.url.pathname;
const hasBreadcrumb = currentPath !== '/';
const currentBreadcrumbLabel =
  breadcrumbLabel ?? (title ? title.split('|')[0].trim() : 'Current page');
const siteOrigin = site.url;
const breadcrumbItems = hasBreadcrumb
  ? [
      { name: 'Home', url: new URL('/', siteOrigin).toString(), href: '/' },
      {
        name: currentBreadcrumbLabel,
        url: new URL(currentPath, siteOrigin).toString(),
        href: currentPath,
      },
    ]
  : [];
---

<SEO title={title} description={description} image={image} type={type} noindex={noindex}>
  <Schema
    type="Organization"
    data={{
      name: 'Vehicle Transport Australia',
      logo: '/logo.svg',
      url: site.url,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+61-123-456-789',
        contactType: 'customer service',
      },
    }}
  />
  {
    breadcrumbItems.length >= 2 && (
      <Schema type="BreadcrumbList" data={{ items: breadcrumbItems }} />
    )
  }
  <div class="font-sans antialiased text-slate-800 bg-slate-50 min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    {
      breadcrumbItems.length >= 2 && (
        <nav class="container mx-auto px-4 pt-4 text-sm text-slate-600" aria-label="Breadcrumb">
          <ol class="flex flex-wrap gap-2">
            {breadcrumbItems.map((item, index) => (
              <li
                class:list={[
                  'flex items-center gap-2',
                  index < breadcrumbItems.length - 1 && 'breadcrumb-link-item',
                ]}
              >
                {index < breadcrumbItems.length - 1 ? (
                  <a class="hover:text-brand-orange-500 hover:underline" href={item.href}>
                    {item.name}
                  </a>
                ) : (
                  <span aria-current="page">{item.name}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <main class="flex-grow" id="main-content">
      <slot />
    </main>
    <Footer />
  </div>
  <script
    is:inline
    src="https://quotes.moveroo.com.au/embed/vehicle-assistant/v1/loader.js"
    data-channel="chatbot-widget"
    data-surface="main-domain-sitewide"
    async></script>
</SEO>

<style is:global>
  .breadcrumb-link-item::after {
    content: '/';
    color: rgb(148 163 184);
  }
</style>

<style is:global>
  .skip-link {
    position: absolute;
    top: 0;
    left: 1rem;
    z-index: 1000;
    transform: translateY(-120%);
    border-radius: 0 0 0.5rem 0.5rem;
    background: #111827;
    color: #ffffff;
    font-weight: 700;
    padding: 0.75rem 1rem;
    text-decoration: none;
    transition: transform 150ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>

---
import SEO from '../components/SEO.astro';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
---

<SEO title={title} description={description} image={image} type={type} noindex={noindex}>
  <Schema
    type="Organization"
    data={{
      name: 'Vehicle Transport Australia',
      logo: '/logo.svg',
      url: import.meta.env.PUBLIC_SITE_URL,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+61-123-456-789',
        contactType: 'customer service',
      },
    }}
  />
  <div class="font-sans antialiased text-slate-800 bg-slate-50 min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main class="flex-grow" id="main-content">
      <slot />
    </main>
    <Footer />
  </div>
  <script
    is:inline
    src="https://quotes.moveroo.com.au/embed/vehicle-assistant/v1/loader.js"
    data-channel="chatbot-widget"
    data-surface="main-domain-sitewide"
    async></script>
</SEO>

<style is:global>
  .skip-link {
    position: absolute;
    top: 0;
    left: 1rem;
    z-index: 1000;
    transform: translateY(-120%);
    border-radius: 0 0 0.5rem 0.5rem;
    background: #111827;
    color: #ffffff;
    font-weight: 700;
    padding: 0.75rem 1rem;
    text-decoration: none;
    transition: transform 150ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>

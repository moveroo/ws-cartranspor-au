---
const contactUrl = 'https://quoting.cartransport.au/contact';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${contactUrl}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={contactUrl} />
    <title>Redirecting to contact</title>
  </head>
  <body>
    <p>Redirecting to <a href={contactUrl}>the Cartransport contact page</a>.</p>
  </body>
</html>

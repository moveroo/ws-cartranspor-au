---
const brand = 'Cartransport';
const canonical = 'https://cartransport.au/agents/examples/';
const breadcrumbItems = [
  { name: 'Home', url: 'https://cartransport.au/' },
  { name: 'Agents', url: 'https://cartransport.au/agents/' },
  { name: 'Examples', url: 'https://cartransport.au/agents/examples/' },
];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{brand} Agent/API Examples</title>
    <meta
      name="description"
      content={`Example customer-consented API requests for Cartransport quote agents.`}
    />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <style>
      body {
        margin: 0;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        color: #17202a;
        background: #f7f4ee;
      }
      main {
        max-width: 920px;
        margin: 0 auto;
        padding: 48px 20px 64px;
      }
      h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        line-height: 1;
        margin: 0 0 18px;
      }
      p,
      li {
        line-height: 1.65;
      }
      a {
        color: #0b5cad;
        text-underline-offset: 3px;
      }
      pre {
        overflow-x: auto;
        background: #111827;
        color: #f9fafb;
        padding: 16px;
        border-radius: 8px;
      }
      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
    </style>
  </head>
  <body>
    <main>
      <nav aria-label="Breadcrumb" class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/agents/">Agents</a></li>
          <li><span aria-current="page">Examples</span></li>
        </ol>
      </nav>
      <h1>{brand} Agent/API Examples</h1>
      <p>
        These examples point agents to the canonical quote host at <a
          href="https://quoting.cartransport.au/">https://quoting.cartransport.au/</a
        >. Use the live OpenAPI schema and capability manifest before submitting production
        requests.
      </p>
      <h2>Vehicle Quote</h2>
      <p>
        No public vehicle submission API is currently available. Hand the customer to the <a
          href="https://quoting.cartransport.au/quote/vehicle">official vehicle quote form</a
        >; the customer must review and submit it.
      </p>
    </main>
    <script
      id="moveroo-vehicle-assistant-loader"
      src="https://quotes.moveroo.com.au/embed/vehicle-assistant/v1/loader.js"
      data-channel="chatbot-widget"
      data-surface="agent-docs"
      data-launcher-label="Vehicle quote"
      data-position="bottom-right"
      data-no-minify="1"
      data-no-defer="1"
      data-cfasync="false"
      async
      is:inline></script>
  </body>
</html>

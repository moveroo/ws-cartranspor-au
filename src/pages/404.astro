---
import SEO from '../components/SEO.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title="Page Not Found"
      description="Sorry, the page you're looking for on Vehicle Transport Australia could not be found. Explore our car transport routes, depot-to-depot services, or get a quote."
      noindex={true}
    />
  </head>
  <body
    class="min-h-screen flex items-center justify-center bg-brand-light text-brand-dark font-sans"
  >
    <main id="main-content" class="text-center px-6">
      <h1 class="text-9xl font-black text-brand-primary/20">404</h1>
      <h2 class="text-2xl font-bold text-brand-dark mt-4">Page Not Found</h2>
      <p class="text-brand-gray mt-2 max-w-md mx-auto">
        Sorry, the page you're looking for doesn't exist or has been moved.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center px-6 py-3 bg-brand-primary hover:bg-brand-secondary text-white font-medium rounded-brand transition-colors shadow-sm"
        >
          <svg
            aria-hidden="true"
            class="w-5 h-5 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
            ></path>
          </svg>
          Go Home
        </a>
        <button
          type="button"
          onclick="history.back()"
          class="inline-flex items-center px-6 py-3 bg-gray-200 hover:bg-gray-300 text-brand-dark font-medium rounded-brand transition-colors"
        >
          <svg
            aria-hidden="true"
            class="w-5 h-5 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Go Back
        </button>
      </div>
    </main>
    <script
      is:inline
      src="https://quotes.moveroo.com.au/embed/vehicle-assistant/v1/loader.js"
      data-channel="chatbot-widget"
      data-surface="main-domain-sitewide"
      async></script>
  </body>
</html>
